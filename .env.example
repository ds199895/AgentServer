# 本地 web 服务监听配置
HOST=127.0.0.1
PORT=18088

# 初始管理员。仅在数据库中不存在该用户时播种；密码必须显式设置。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 终端配置
# 持久交互式 shell；TERMINAL_CMD 退出后会回到这个 shell
# TERMINAL_SHELL=/bin/zsh
TERMINAL_CMD=codex
TERMINAL_CWD=.
# TERMINAL_PROXY=http://127.0.0.1:7890
TERMINAL_SCROLLBACK_BYTES=2097152

# 使用 HTTPS 对外提供服务时设置为 1
COOKIE_SECURE=0
# 可选：固定 HMAC 会话密钥；不设置时自动生成到 data/session_secret
# SESSION_SECRET=replace-with-a-long-random-string

# 集中设备管理。留空时不启动 FRP 状态同步。
# FRPS_DASHBOARD_URL=http://127.0.0.1:7500
# FRPS_DASHBOARD_USER=admin
# FRPS_DASHBOARD_PASSWORD=replace-me
# FRPS_SYNC_INTERVAL=15
# FRPS_AUTO_DISCOVER=1
# FRP_PROXY_HOST=127.0.0.1

# 集中部署时建议禁用服务器本地 PTY，只允许设备 SSH 终端。
ENABLE_LOCAL_TERMINALS=1
# SSH_PRIVATE_KEY=/var/lib/agentserver/ssh/id_ed25519
# SSH_KNOWN_HOSTS=/var/lib/agentserver/ssh/known_hosts
# SSH_STRICT_HOST_KEY=accept-new

# 设备本地开发服务预览。正式环境需配置泛域名 DNS 和证书。
# PREVIEW_PUBLIC_ORIGIN=https://preview.example.com
# PREVIEW_IDLE_TIMEOUT=1800
# SERVICE_PROBE_INTERVAL=10
# SERVICE_PROBE_TIMEOUT=6
# SERVICE_PROBE_FAILURES=2
# SERVICE_PROBE_CONCURRENCY=3
# SERVICE_PROCESS_SCAN_INTERVAL=10
# SERVICE_PROCESS_SCAN_TIMEOUT=5
# SERVICE_PROCESS_SCAN_CONCURRENCY=3
# SERVICE_PROCESS_PROBE_TIMEOUT=2
# SERVICE_PROCESS_MISSING_SCANS=2
# SERVICE_PROCESS_MIN_PORT=1024
