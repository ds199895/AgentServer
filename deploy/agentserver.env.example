DATA_DIR=/var/lib/agentserver
WEB_DIST=/opt/agentserver/current/web_dist
ENVIRONMENT=production

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET
COOKIE_SECURE=0

ENABLE_LOCAL_TERMINALS=0
TERMINAL_CWD=/var/lib/agentserver
TERMINAL_CMD=
TERMINAL_BACKEND=tmux
TMUX_SOCKET=/var/lib/agentserver/tmux/agentserver.sock

# 只读工作区、短时文件授权与 read-image 内容寻址附件限制
FILE_GRANT_TTL=120
MAX_WORKSPACE_FILE_BYTES=33554432
MAX_WORKSPACE_READ_BYTES=33554432
MAX_WORKSPACE_LIST_ENTRIES=1000
MAX_IMAGE_ATTACHMENT_BYTES=5242880
MAX_IMAGE_ATTACHMENT_PIXELS=40000000
ARTIFACT_INGEST_QUEUE_SIZE=1024

FRPS_DASHBOARD_URL=http://127.0.0.1:7500
FRPS_DASHBOARD_USER=admin
FRPS_DASHBOARD_PASSWORD=CHANGE_ME
FRPS_SYNC_INTERVAL=15
FRPS_AUTO_DISCOVER=1
FRP_PROXY_HOST=127.0.0.1

SSH_PRIVATE_KEY=/var/lib/agentserver/ssh/id_ed25519
SSH_KNOWN_HOSTS=/var/lib/agentserver/ssh/known_hosts
SSH_STRICT_HOST_KEY=accept-new
SSH_CONNECT_TIMEOUT=10
SFTP_OPERATION_TIMEOUT=15

PREVIEW_PUBLIC_ORIGIN=https://preview.metakroma.com
PREVIEW_IDLE_TIMEOUT=1800
SERVICE_PROBE_INTERVAL=10
SERVICE_PROBE_TIMEOUT=6
SERVICE_PROBE_FAILURES=2
SERVICE_PROBE_CONCURRENCY=3
SERVICE_PROCESS_SCAN_INTERVAL=10
SERVICE_PROCESS_SCAN_TIMEOUT=5
SERVICE_PROCESS_SCAN_CONCURRENCY=3
SERVICE_PROCESS_PROBE_TIMEOUT=2
SERVICE_PROCESS_MISSING_SCANS=2
SERVICE_PROCESS_MIN_PORT=1024
